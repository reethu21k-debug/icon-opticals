# ============================================================
# LENSKART-CLONE: Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-side only, never expose

# ── Cloudinary ────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret                  # Server-side only

# ── Gmail SMTP ────────────────────────────────────────────────
GMAIL_USER=yourapp@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx                 # Gmail App Password (not your login password)
# Enable 2FA on Gmail, then generate App Password at:
# https://myaccount.google.com/apppasswords

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000              # Change to your production URL
ADMIN_API_SECRET=generate-a-strong-random-secret-here  # Used for internal API calls
NEXT_PUBLIC_ADMIN_API_SECRET=same-as-above             # For client-side admin triggers

# ── Puppeteer (for PDF generation on Vercel) ─────────────────
# Not needed locally — puppeteer handles this automatically
# On Vercel: use @sparticuz/chromium package instead
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
